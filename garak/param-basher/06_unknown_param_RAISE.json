{
  "run": {
    "generations": 2,
    "soft_probe_prompt_cap": 3
  },
  "plugins": {
    "probe_spec": "hyperparams.HyperparamBasher",
    "target_type": "openai.OpenAICompatible",
    "target_name": "mistralai/mistral-nemo",
    "generators": {
      "openai": {
        "OpenAICompatible": {
          "uri": "https://openrouter.ai/api/v1"
        }
      }
    },
    "probes": {
      "hyperparams": {
        "HyperparamBasher": {
          "source_probe": "packagehallucination.Python",
          "param_space": {
            "nonexistent_param": [1, 2]
          }
        }
      }
    }
  },
  "reporting": {
    "report_dir": "."
  }
}
